<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/black">

    <!-- Status Header -->
    <TextView
        android:id="@+id/tv_ride_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vehicle Idle"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/aaos_primary"
        android:gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <!-- Offer Card (Visible only when offer received) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_offer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/card_bg"
        android:visibility="gone">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            
            <TextView
                android:text="New Ride Request"
                android:textSize="24sp"
                android:textColor="@color/white"/>
            
            <TextView
                android:id="@+id/tv_destination"
                android:text="To: Cyber Hub"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>
                
             <TextView
                android:id="@+id/tv_fare"
                android:text="₹150 • 4.2 km"
                android:textSize="32sp"
                android:textColor="@color/aaos_accent"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="ACCEPT RIDE"
                android:textSize="28sp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/aaos_primary"/>
                
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- In-Ride Navigation Mock -->
    <LinearLayout
        android:id="@+id/layout_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        
        <TextView
            android:text="Next Turn: 200m"
            android:textSize="24sp"
            android:textColor="@color/text_secondary"/>
            
        <TextView
            android:text="TURN RIGHT"
            android:textSize="56sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
            
        <TextView
            android:id="@+id/tv_eta"
            android:text="ETA: 12:45 PM"
            android:textSize="32sp"
            android:textColor="@color/aaos_primary"
            android:layout_marginTop="24dp"/>
            
        <Button
            android:id="@+id/btn_complete"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="COMPLETE RIDE"
            android:textSize="28sp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/aaos_accent"/>
            
    </LinearLayout>

</LinearLayout>
